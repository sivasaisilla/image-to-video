rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function to check if user owns the resource
    function ownsResource() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ============ USERS ============
    match /users/{userId} {
      // Users can read and update their own profile
      allow read: if isOwner(userId);
      allow update: if isOwner(userId);
      // Only Cloud Functions can create users (via Auth trigger)
      allow create: if false;
      allow delete: if false;

      // Subcollection: credit_ledger (transaction history)
      match /credit_ledger/{entryId} {
        allow read: if isOwner(userId);
        // Only Cloud Functions can modify credit ledger
        allow create, update, delete: if false;
      }

      // Subcollection: wizard_sessions (wizard form data)
      match /wizard_sessions/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============ PROJECTS ============
    match /projects/{projectId} {
      // Users can CRUD their own projects
      allow read: if ownsResource();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsResource();
      allow delete: if ownsResource();

      // Subcollection: photos
      match /photos/{photoId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.uid == request.auth.uid;
        allow create, update, delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.uid == request.auth.uid;
      }
    }

    // ============ JOBS ============
    match /jobs/{jobId} {
      // Users can read their own jobs
      allow read: if ownsResource();
      // Cloud Functions create jobs, but also allow client creation for status polling
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // Only Cloud Functions can modify
    }

    // ============ ASSETS ============
    match /assets/{assetId} {
      // Users can read their own assets
      allow read: if ownsResource();
      // Users can create and update their own assets
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if ownsResource();
      allow delete: if ownsResource();
    }

    // ============ PLANS ============
    match /plans/{planId} {
      // Everyone can read plans (public pricing)
      allow read: if true;
      // Only admins can modify plans (via Firebase Console)
      allow write: if false;
    }

    // ============ MUSIC CATALOG ============
    match /music_catalog/{songId} {
      // Everyone can read music catalog (public)
      allow read: if true;
      // Only Cloud Functions can modify music catalog
      allow write: if false;
    }

    // ============ REFERRALS ============
    match /referrals/{referralId} {
      // Users can read referrals where they are the referrer
      allow read: if isAuthenticated() && resource.data.referrerUid == request.auth.uid;
      // Only Cloud Functions can create/update referrals
      allow create, update, delete: if false;
    }

    // ============ CREDIT LEDGER (Old global collection) ============
    // Deprecated - now under users/{uid}/credit_ledger
    match /credit_ledger/{entryId} {
      allow read, write: if false;
    }

    // ============ PAYMENTS ============
    match /payments/{paymentId} {
      // Users can read their own payments
      allow read: if ownsResource();
      // Only Cloud Functions (Stripe webhook) can create payments
      allow create, update, delete: if false;
    }

    // ============ OTPs (if using custom OTP) ============
    match /otps/{otpId} {
      // No client access - only Cloud Functions
      allow read, write: if false;
    }
  }
}
